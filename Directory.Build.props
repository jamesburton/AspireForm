<Project>
  <!--
    Repo-wide MSBuild properties. Applied to every project in this tree unless overridden.

    Warnings policy:
      Warnings are treated as errors. This catches drift before it accumulates and
      prevents pipelines from breaking when a warning threshold increases. Agents
      MUST NOT bypass this by ad-hoc NoWarn unless the rule is added to the
      WarningsNotAsErrors list below with a clear reason.

    Exempted rules (warning, not error):
      - xUnit1051: ~338 pre-existing instances across the test suite calling
        methods that accept CancellationToken with `default` or
        CancellationToken.None instead of TestContext.Current.CancellationToken.
        Mechanical fix; TODO: address in a dedicated cleanup pass.
      - NU1608: HtmlSanitizer 9.0.892 (a transitive dep of bUnit) pins AngleSharp
        0.17.1 but the resolution picks 1.2.0. Out of our control until upstream
        bUnit/HtmlSanitizer update; harmless at runtime.
  -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>xUnit1051;NU1608</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
