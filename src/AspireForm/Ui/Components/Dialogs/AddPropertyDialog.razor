@* AddPropertyDialog — dialog for adding a new property to an existing entity. Parent controls open state via conditional render. *@
@inject IEntityCatalogService Catalog

<BbDialog Open="true" OpenChanged="HandleOpenChanged">
    <BbDialogContent class="sm:max-w-sm">
        <BbDialogHeader>
            <BbDialogTitle>Add Property</BbDialogTitle>
            <BbDialogDescription>Add a new property to <strong>@EntityName</strong>.</BbDialogDescription>
        </BbDialogHeader>

        <div class="grid gap-4 py-4">
            <div class="grid gap-1.5">
                <label class="text-sm font-medium" for="prop-name">Name</label>
                <BbInput Id="prop-name" Placeholder="e.g. Title" @bind-Value="Name" class="w-full" />
            </div>
            <div class="grid gap-1.5">
                <label class="text-sm font-medium" for="prop-type">CLR type</label>
                <BbInput Id="prop-type" Placeholder="string" @bind-Value="ClrType" class="w-full" />
            </div>
            <div class="flex items-center gap-3">
                <input type="checkbox" id="prop-nullable" @bind="IsNullable" class="h-4 w-4 rounded border-input" />
                <label class="text-sm font-medium" for="prop-nullable">Nullable</label>
            </div>
            <div class="flex items-center gap-3">
                <input type="checkbox" id="prop-pk" @bind="IsPrimaryKey" class="h-4 w-4 rounded border-input" />
                <label class="text-sm font-medium" for="prop-pk">Primary key</label>
            </div>

            @if (LastError is not null)
            {
                <BbAlert Variant="AlertVariant.Danger">
                    <BbAlertDescription>@LastError</BbAlertDescription>
                </BbAlert>
            }
        </div>

        <BbDialogFooter>
            <BbDialogClose AsChild="true">
                <BbButton Variant="ButtonVariant.Outline">Cancel</BbButton>
            </BbDialogClose>
            <BbButton Variant="ButtonVariant.Default" @onclick="AddAsync">Add</BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@code {
    /// <summary>Absolute path to the Web project .csproj file.</summary>
    [Parameter] public string? CsprojPath { get; set; }

    /// <summary>Name of the entity to add the property to.</summary>
    [Parameter] public string EntityName { get; set; } = "";

    /// <summary>Raised when the dialog should be closed without adding.</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Raised after the property is successfully added.</summary>
    [Parameter] public EventCallback OnAdded { get; set; }

    private string Name { get; set; } = "";
    private string ClrType { get; set; } = "string";
    private bool IsNullable { get; set; }
    private bool IsPrimaryKey { get; set; }
    private string? LastError { get; set; }

    private async Task HandleOpenChanged(bool open)
    {
        if (!open)
            await OnClose.InvokeAsync();
    }

    private async Task AddAsync()
    {
        LastError = null;
        if (string.IsNullOrWhiteSpace(Name) || string.IsNullOrWhiteSpace(ClrType))
        {
            LastError = "Name and CLR type are required.";
            return;
        }
        var prop = new Property(Name, ClrType, IsNullable, IsPrimaryKey, []);
        var r = await Catalog.MutateAsync(CsprojPath!, new AddProperty(EntityName, prop), default);
        if (!r.Success) { LastError = r.Diagnostics.FirstOrDefault()?.Message ?? "Add failed."; return; }
        await OnAdded.InvokeAsync();
    }
}
