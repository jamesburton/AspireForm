@* NewEndpointDialog — dialog for creating a new minimal-API endpoint handler. Parent controls open state via conditional render. *@
@inject IEndpointCatalogService EndpointCatalog

<BbDialog Open="true" OpenChanged="HandleOpenChanged">
    <BbDialogContent class="sm:max-w-lg">
        <BbDialogHeader>
            <BbDialogTitle>New Endpoint</BbDialogTitle>
            <BbDialogDescription>Scaffold a new minimal-API endpoint handler in your project.</BbDialogDescription>
        </BbDialogHeader>

        <div class="grid gap-4 py-4">
            <div class="grid gap-1.5">
                <label class="text-sm font-medium" for="ep-route">Route</label>
                <BbInput Id="ep-route" Placeholder="/resource/{id}" @bind-Value="Route" class="w-full" />
            </div>
            <div class="grid gap-1.5">
                <label class="text-sm font-medium" for="ep-method">HTTP Method</label>
                <select id="ep-method" class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm" @bind="HttpMethod">
                    <option>GET</option>
                    <option>POST</option>
                    <option>PUT</option>
                    <option>PATCH</option>
                    <option>DELETE</option>
                </select>
            </div>
            <div class="grid gap-1.5">
                <label class="text-sm font-medium" for="ep-type">Handler type</label>
                <BbInput Id="ep-type" Placeholder="e.g. BooksHandler" @bind-Value="TypeName" class="w-full" />
            </div>
            <div class="grid gap-1.5">
                <label class="text-sm font-medium" for="ep-meth">Method name</label>
                <BbInput Id="ep-meth" Placeholder="e.g. GetBooks" @bind-Value="MethodName" class="w-full" />
            </div>
            <div class="grid gap-1.5">
                <label class="text-sm font-medium" for="ep-ns">Namespace</label>
                <BbInput Id="ep-ns" Placeholder="Demo.Handlers" @bind-Value="Namespace" class="w-full" />
            </div>
            <div class="grid gap-1.5">
                <label class="text-sm font-medium" for="ep-path">File path</label>
                <BbInput Id="ep-path" Placeholder="@($"{DefaultDir}/Endpoints/Handler.cs")" @bind-Value="FilePath" class="w-full" />
            </div>

            @if (LastError is not null)
            {
                <BbAlert Variant="AlertVariant.Danger">
                    <BbAlertDescription>@LastError</BbAlertDescription>
                </BbAlert>
            }
        </div>

        <BbDialogFooter>
            <BbDialogClose AsChild="true">
                <BbButton Variant="ButtonVariant.Outline">Cancel</BbButton>
            </BbDialogClose>
            <BbButton Variant="ButtonVariant.Default" @onclick="CreateAsync">Create</BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@code {
    /// <summary>Absolute path to the Web project .csproj file.</summary>
    [Parameter] public string? CsprojPath { get; set; }

    /// <summary>Default directory used to resolve relative file paths.</summary>
    [Parameter] public string DefaultDir { get; set; } = "";

    /// <summary>Raised when the dialog should be closed without creating.</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Raised after a new endpoint is successfully created.</summary>
    [Parameter] public EventCallback OnCreated { get; set; }

    private string Route { get; set; } = "";
    private string HttpMethod { get; set; } = "GET";
    private string TypeName { get; set; } = "";
    private string MethodName { get; set; } = "";
    private string Namespace { get; set; } = "";
    private string FilePath { get; set; } = "";
    private string? LastError { get; set; }

    private async Task HandleOpenChanged(bool open)
    {
        if (!open)
            await OnClose.InvokeAsync();
    }

    private async Task CreateAsync()
    {
        LastError = null;
        if (string.IsNullOrWhiteSpace(Route) || string.IsNullOrWhiteSpace(TypeName)
            || string.IsNullOrWhiteSpace(MethodName) || string.IsNullOrWhiteSpace(Namespace))
        {
            LastError = "Route, handler type, method name, and namespace are required.";
            return;
        }
        var absPath = string.IsNullOrWhiteSpace(FilePath)
            ? Path.Combine(DefaultDir, "Endpoints", $"{TypeName}.cs")
            : (Path.IsPathRooted(FilePath) ? FilePath : Path.Combine(DefaultDir, FilePath));
        var r = await EndpointCatalog.MutateAsync(CsprojPath!, new CreateEndpoint(MethodName, TypeName, Route, HttpMethod, absPath, Namespace), default);
        if (!r.Success) { LastError = r.Diagnostics.FirstOrDefault()?.Message ?? "Create failed."; return; }
        await OnCreated.InvokeAsync();
    }
}
