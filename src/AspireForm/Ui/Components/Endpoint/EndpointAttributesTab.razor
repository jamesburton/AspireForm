@if (Endpoint is null || ProjectPath is null) { return; }

<div class="space-y-3">
    <BbCard>
        <BbCardContent class="p-0">
            <table class="w-full text-sm">
                <thead>
                    <tr class="border-b bg-muted/50 text-muted-foreground">
                        <th class="px-4 py-2 text-left font-medium">Attribute</th>
                        <th class="px-4 py-2 text-left font-medium">Args</th>
                        <th class="px-4 py-2 w-20"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Endpoint.Attributes)
                    {
                        var aTypeName = a.FullTypeName;
                        <tr class="border-b last:border-b-0 hover:bg-muted/30 transition-colors">
                            <td class="px-4 py-2 font-mono text-xs">@a.FullTypeName</td>
                            <td class="px-4 py-2 font-mono text-xs text-muted-foreground">@FormatArgs(a)</td>
                            <td class="px-4 py-2 text-right">
                                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small"
                                          class="text-destructive hover:text-destructive"
                                          @onclick="() => ClearAsync(aTypeName)">Clear</BbButton>
                            </td>
                        </tr>
                    }
                    @if (Endpoint.Attributes.Count == 0)
                    {
                        <tr>
                            <td colspan="3" class="px-4 py-3 text-center text-sm text-muted-foreground">No method-level attributes.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </BbCardContent>
    </BbCard>

    @if (LastError is not null)
    {
        <BbAlert Variant="AlertVariant.Danger">
            <BbAlertDescription>@LastError</BbAlertDescription>
        </BbAlert>
    }
</div>

@code {
    /// <summary>The currently selected endpoint.</summary>
    [Parameter] public EndpointInfo? Endpoint { get; set; }

    /// <summary>The endpoint catalog service used to dispatch mutations.</summary>
    [Parameter] public IEndpointCatalogService? Service { get; set; }

    /// <summary>Absolute path to the Web project .csproj file.</summary>
    [Parameter] public string? ProjectPath { get; set; }

    /// <summary>Raised after a successful mutation so the parent page can re-scan.</summary>
    [Parameter] public EventCallback OnMutated { get; set; }

    private string? LastError { get; set; }

    private static string FormatArgs(AttributeInstance a)
    {
        var parts = new List<string>();
        foreach (var c in a.ConstructorArgs) parts.Add(c?.ToString() ?? "null");
        foreach (var n in a.NamedArgs) parts.Add($"{n.Key}={n.Value}");
        return parts.Count == 0 ? "" : string.Join(", ", parts);
    }

    private async Task ClearAsync(string fullTypeName)
    {
        LastError = null;
        if (Service is null || ProjectPath is null) return;
        var r = await Service.MutateAsync(ProjectPath!, new ClearEndpointAttribute(Endpoint!.MethodName, Endpoint.HandlerTypeName, fullTypeName), default);
        if (!r.Success) { LastError = r.Diagnostics.FirstOrDefault()?.Message ?? "Clear failed."; return; }
        await OnMutated.InvokeAsync();
    }
}
