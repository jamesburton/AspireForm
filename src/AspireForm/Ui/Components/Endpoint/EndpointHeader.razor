@if (Endpoint is not null)
{
    <div class="mb-4 space-y-1">
        <div class="flex items-baseline gap-2">
            <BbBadge Variant="BadgeVariant.Secondary" class="font-mono text-xs">@Endpoint.HttpMethod</BbBadge>
            <h2 class="text-xl font-semibold font-mono">@Endpoint.Route</h2>
        </div>
        <p class="text-sm text-muted-foreground">@Endpoint.HandlerTypeName.@Endpoint.MethodName · @System.IO.Path.GetFileName(Endpoint.FilePath)</p>
    </div>
}

@code {
    /// <summary>The currently selected endpoint.</summary>
    [Parameter] public EndpointInfo? Endpoint { get; set; }
}
