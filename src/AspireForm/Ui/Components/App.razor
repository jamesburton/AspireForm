<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AspireForm — Entity Model Builder</title>
    <base href="/" />
    <link rel="stylesheet" href="site.css" />
    <link id="af-theme" rel="stylesheet" href="/theme.css" />
    <HeadOutlet />
</head>
<body>
    @* prerender:false ensures the page does not render SSR first; the interactive circuit
       renders the page once it is connected. Avoids a class of issue where a slow
       OnInitializedAsync during the SSR phase causes the static HTML to ship without
       the corresponding interactive upgrade ever wiring the event handlers. *@
    <Routes @rendermode="@(new InteractiveServerRenderMode(prerender: false))" />
    <script src="_framework/blazor.web.js"></script>
    <script src="/theme-interop.js"></script>
</body>
</html>
