<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AspireForm</title>
    <base href="/" />
    <!-- Active theme CSS variables (served dynamically by /theme.css endpoint) -->
    <link id="af-theme" rel="stylesheet" href="/theme.css" />
    <!-- Blueprint pre-built styles (Tailwind v4 + shadcn/ui primitives) -->
    <link rel="stylesheet" href="_content/BlazorBlueprint.Components/blazorblueprint.css" />
    <!-- AspireForm-specific overrides -->
    <link rel="stylesheet" href="/app.css" />
    <HeadOutlet />
</head>
<body>
    @* prerender:false ensures the page does not render SSR first; the interactive circuit
       renders the page once it is connected. Avoids a class of issue where a slow
       OnInitializedAsync during the SSR phase causes the static HTML to ship without
       the corresponding interactive upgrade ever wiring the event handlers. *@
    <Routes @rendermode="@(new InteractiveServerRenderMode(prerender: false))" />
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
