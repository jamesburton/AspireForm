<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AspireForm</title>
    <base href="/" />
    <!-- Active theme CSS variables (served dynamically by /theme.css endpoint) -->
    <link id="af-theme" rel="stylesheet" href="/theme.css" />
    <!-- Blueprint pre-built styles (Tailwind v4 + shadcn/ui primitives) -->
    <link rel="stylesheet" href="_content/BlazorBlueprint.Components/blazorblueprint.css" />
    <!-- AspireForm-specific overrides -->
    <link rel="stylesheet" href="/app.css" />
    <HeadOutlet />
</head>
<body>
    @* Use InteractiveServer with the default prerender:true so users see the SSR'd layout
       immediately while the interactive circuit upgrades in the background. Page-level
       @rendermode InteractiveServer on each route ensures event handlers work after upgrade. *@
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
