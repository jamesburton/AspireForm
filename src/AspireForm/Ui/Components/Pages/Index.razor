@page "/"
@inject NavigationManager Nav
@inject UiOptions Options

<PageTitle>AspireForm</PageTitle>

<div class="max-w-xl space-y-4">
    <div>
        <h1 class="text-2xl font-semibold tracking-tight">AspireForm</h1>
        <p class="text-muted-foreground text-sm">Declarative construction and configuration of .NET Aspire applications.</p>
    </div>

    <BbCard>
        <BbCardContent class="pt-6 space-y-2">
            <p class="text-sm text-muted-foreground">Project directory</p>
            <p class="font-mono text-sm bg-muted px-2 py-1 rounded">@Options.ProjectDir</p>
        </BbCardContent>
        <BbCardFooter>
            <BbButton Variant="ButtonVariant.Default" href="/entities">Browse entities</BbButton>
        </BbCardFooter>
    </BbCard>
</div>

@code {
    // v1 simply links to /entities. A later iteration may auto-redirect when there's exactly one ef-data block.
}
