@page "/endpoints"
@rendermode InteractiveServer
@inject IEndpointCatalogService EndpointCatalog
@inject UiOptions Options

<PageTitle>Endpoints — AspireForm</PageTitle>

<div class="af-two-pane">
    @* Sidebar: search + new endpoint + list *@
    <aside class="af-two-pane-sidebar flex flex-col gap-2 p-2 overflow-y-auto">
        <BbInput Placeholder="Search endpoints…" @bind-Value="Filter" UpdateTiming="UpdateTiming.Immediate" class="w-full" />
        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" class="w-full" @onclick="() => ShowNewEndpoint = true">+ New Endpoint</BbButton>

        <div class="space-y-0.5 mt-1">
            @foreach (var ep in FilteredEndpoints.OrderBy(e => e.Route, StringComparer.Ordinal))
            {
                var epKey = $"{ep.HandlerTypeName}.{ep.MethodName}";
                var selKey = Selected is null ? "" : $"{Selected.HandlerTypeName}.{Selected.MethodName}";
                <button type="button"
                        class="w-full text-left px-3 py-1.5 rounded-md text-sm transition-colors hover:bg-accent hover:text-accent-foreground @(selKey == epKey ? "bg-accent text-accent-foreground font-medium" : "text-foreground")"
                        @onclick="() => Select(ep)">
                    <BbBadge Variant="BadgeVariant.Secondary" class="mr-1 font-mono text-xs">@ep.HttpMethod</BbBadge>
                    @ep.Route
                </button>
            }
            @if (FilteredEndpoints.Count == 0)
            {
                <p class="px-3 py-2 text-sm text-muted-foreground">No endpoints</p>
            }
        </div>
    </aside>

    @* Detail panel *@
    <div class="af-two-pane-detail">
        @if (LoadError is not null)
        {
            <BbAlert Variant="AlertVariant.Danger" class="mb-4">
                <BbAlertDescription>@LoadError</BbAlertDescription>
            </BbAlert>
        }
        @if (Selected is null)
        {
            <p class="text-muted-foreground text-sm">Select an endpoint from the sidebar.</p>
        }
        else
        {
            <EndpointHeader Endpoint="@Selected" />

            <BbTabs @bind-Value="ActiveTab" class="mt-4">
                <BbTabsList>
                    <BbTabsTrigger Value="parameters">Parameters (@Selected.Parameters.Count)</BbTabsTrigger>
                    <BbTabsTrigger Value="auth">Auth</BbTabsTrigger>
                    <BbTabsTrigger Value="attributes">Attributes (@Selected.Attributes.Count)</BbTabsTrigger>
                </BbTabsList>
                <BbTabsContent Value="parameters">
                    <EndpointParametersTab Endpoint="@Selected" Service="@EndpointCatalog" ProjectPath="@CsprojPath" OnMutated="ReloadAsync" />
                </BbTabsContent>
                <BbTabsContent Value="auth">
                    <EndpointAuthTab Endpoint="@Selected" Service="@EndpointCatalog" ProjectPath="@CsprojPath" OnMutated="ReloadAsync" />
                </BbTabsContent>
                <BbTabsContent Value="attributes">
                    <EndpointAttributesTab Endpoint="@Selected" Service="@EndpointCatalog" ProjectPath="@CsprojPath" OnMutated="ReloadAsync" />
                </BbTabsContent>
            </BbTabs>
        }
    </div>
</div>

@if (ShowNewEndpoint)
{
    <NewEndpointDialog CsprojPath="@CsprojPath" DefaultDir="@DefaultEndpointDir" OnClose="() => { ShowNewEndpoint = false; }" OnCreated="ReloadAsync" />
}

@code {
    private string Filter { get; set; } = "";
    private string ActiveTab { get; set; } = "parameters";
    private EndpointInfo? Selected { get; set; }
    private EndpointCatalog? CatalogSnapshot { get; set; }
    private string? CsprojPath { get; set; }
    private string DefaultEndpointDir => CsprojPath is null ? Options.ProjectDir : Path.GetDirectoryName(CsprojPath)!;
    private string? LoadError { get; set; }
    private bool ShowNewEndpoint { get; set; }

    private IReadOnlyList<EndpointInfo> FilteredEndpoints =>
        CatalogSnapshot is null ? []
        : string.IsNullOrEmpty(Filter)
            ? CatalogSnapshot.Endpoints
            : CatalogSnapshot.Endpoints.Where(e =>
                e.Route.Contains(Filter, StringComparison.OrdinalIgnoreCase)
                || e.MethodName.Contains(Filter, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        try
        {
            CsprojPath ??= Directory.EnumerateFiles(Options.ProjectDir, "*.csproj", SearchOption.AllDirectories).FirstOrDefault();
            if (CsprojPath is null)
            {
                LoadError = $"No .csproj found under '{Options.ProjectDir}'.";
                return;
            }
            CatalogSnapshot = await EndpointCatalog.ScanAsync(CsprojPath, default);
            LoadError = null;
            // Re-pick selected endpoint after reload.
            if (Selected is not null)
            {
                Selected = CatalogSnapshot.Endpoints.FirstOrDefault(e =>
                    e.MethodName == Selected.MethodName && e.HandlerTypeName == Selected.HandlerTypeName);
            }
        }
        catch (Exception ex)
        {
            LoadError = $"Scan failed: {ex.Message}";
        }
    }

    private void Select(EndpointInfo ep) => Selected = ep;
}
