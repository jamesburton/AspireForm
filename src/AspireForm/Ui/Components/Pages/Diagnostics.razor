@page "/diagnostics"
@rendermode InteractiveServer
@inject IEntityCatalogService Catalog
@inject UiOptions Options

<PageTitle>Diagnostics — AspireForm</PageTitle>

<div class="space-y-4">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-semibold tracking-tight">Diagnostics</h1>
            <p class="text-muted-foreground text-sm">Roslyn workspace scan results.</p>
        </div>
        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" @onclick="ScanAsync"
                  Disabled="@(LoadingState == State.Loading)">
            @(LoadingState == State.Loading ? "Scanning…" : "Run scan")
        </BbButton>
    </div>

    @if (LoadingState == State.NotStarted)
    {
        <BbAlert Variant="AlertVariant.Default">
            <BbAlertDescription>No project scanned yet. Click <strong>Run scan</strong> to start.</BbAlertDescription>
        </BbAlert>
    }
    else if (LoadingState == State.Loading)
    {
        <BbAlert Variant="AlertVariant.Default">
            <BbAlertDescription>Scanning workspace… first scan can take several seconds.</BbAlertDescription>
        </BbAlert>
    }
    else if (LoadError is not null)
    {
        <BbAlert Variant="AlertVariant.Danger">
            <BbAlertDescription>@LoadError</BbAlertDescription>
        </BbAlert>
    }
    else if (Snapshot is null || Snapshot.Diagnostics.Count == 0)
    {
        <BbAlert Variant="AlertVariant.Default">
            <BbAlertDescription>No diagnostics — workspace loaded clean.</BbAlertDescription>
        </BbAlert>
        @if (LastScanAt is not null)
        {
            <p class="text-xs text-muted-foreground">Last scan: @LastScanAt</p>
        }
    }
    else
    {
        @if (LastScanAt is not null)
        {
            <p class="text-xs text-muted-foreground">Last scan: @LastScanAt</p>
        }
        <BbCard>
            <BbCardContent class="p-0">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="border-b bg-muted/50 text-muted-foreground">
                            <th class="px-4 py-2 text-left font-medium">Severity</th>
                            <th class="px-4 py-2 text-left font-medium">Message</th>
                            <th class="px-4 py-2 text-left font-medium">File</th>
                            <th class="px-4 py-2 text-left font-medium w-16">Line</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Snapshot.Diagnostics)
                        {
                            <tr class="border-b last:border-b-0 hover:bg-muted/30 transition-colors">
                                <td class="px-4 py-2">@d.Severity</td>
                                <td class="px-4 py-2">@d.Message</td>
                                <td class="px-4 py-2 font-mono text-xs text-muted-foreground truncate max-w-xs">@d.FilePath</td>
                                <td class="px-4 py-2 text-right">@d.Line</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </BbCardContent>
        </BbCard>
    }
</div>

@code {
    private enum State { NotStarted, Loading, Loaded, Errored }
    private State LoadingState { get; set; }
    private EntityCatalog? Snapshot { get; set; }
    private string? LoadError { get; set; }
    private string? LastScanAt { get; set; }

    protected override void OnInitialized()
    {
        // On page load, render the shell immediately. If a prior page already scanned, show its
        // cached snapshot without re-scanning. Otherwise wait for the user to click "Run scan".
        var csproj = Directory.EnumerateFiles(Options.ProjectDir, "*.csproj", SearchOption.AllDirectories).FirstOrDefault();
        if (csproj is null) { LoadError = $"No .csproj found under '{Options.ProjectDir}'."; LoadingState = State.Errored; return; }

        if (Catalog is RoslynEntityCatalogService rs)
        {
            var cached = rs.GetLastSnapshot(csproj);
            if (cached is not null)
            {
                Snapshot = cached;
                LastScanAt = DateTime.Now.ToString("HH:mm:ss") + " (from cache)";
                LoadingState = State.Loaded;
                return;
            }
        }
        LoadingState = State.NotStarted;
    }

    private async Task ScanAsync()
    {
        var csproj = Directory.EnumerateFiles(Options.ProjectDir, "*.csproj", SearchOption.AllDirectories).FirstOrDefault();
        if (csproj is null) { LoadError = $"No .csproj found under '{Options.ProjectDir}'."; LoadingState = State.Errored; return; }

        LoadingState = State.Loading;
        StateHasChanged();
        try
        {
            Snapshot = await Catalog.ScanAsync(csproj, default);
            LastScanAt = DateTime.Now.ToString("HH:mm:ss");
            LoadingState = State.Loaded;
        }
        catch (Exception ex)
        {
            LoadError = $"Scan failed: {ex.Message}";
            LoadingState = State.Errored;
        }
    }
}
