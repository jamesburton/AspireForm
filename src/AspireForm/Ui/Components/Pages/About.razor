@page "/about"
@inject UiOptions Options

<PageTitle>About — AspireForm</PageTitle>

<div class="max-w-xl space-y-4">
    <div>
        <h1 class="text-2xl font-semibold tracking-tight">About</h1>
        <p class="text-muted-foreground text-sm">AspireForm runtime information.</p>
    </div>

    <BbCard>
        <BbCardContent class="pt-6 space-y-3">
            <div class="flex items-center gap-3 text-sm">
                <span class="w-32 shrink-0 text-muted-foreground">Version</span>
                <code class="font-mono bg-muted px-2 py-0.5 rounded">@(typeof(UiOptions).Assembly.GetName().Version?.ToString() ?? "0.0.0")</code>
            </div>
            <BbSeparator />
            <div class="flex items-start gap-3 text-sm">
                <span class="w-32 shrink-0 text-muted-foreground">Project directory</span>
                <code class="font-mono bg-muted px-2 py-0.5 rounded break-all">@Options.ProjectDir</code>
            </div>
            <BbSeparator />
            <div class="flex items-center gap-3 text-sm">
                <span class="w-32 shrink-0 text-muted-foreground">Port</span>
                <code class="font-mono bg-muted px-2 py-0.5 rounded">@Options.Port</code>
            </div>
        </BbCardContent>
        <BbCardFooter>
            <p class="text-xs text-muted-foreground">Stop the host with <code class="bg-muted px-1 rounded">Ctrl+C</code> in the terminal where you started <code class="bg-muted px-1 rounded">aspireform ui</code>.</p>
        </BbCardFooter>
    </BbCard>
</div>
