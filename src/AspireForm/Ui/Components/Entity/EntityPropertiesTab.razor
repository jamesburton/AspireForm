@inject IEntityCatalogService Catalog

@if (Entity is null || CsprojPath is null) { return; }

<div class="space-y-3">
    <BbCard>
        <BbCardContent class="p-0">
            <table class="w-full text-sm">
                <thead>
                    <tr class="border-b bg-muted/50 text-muted-foreground">
                        <th class="px-4 py-2 text-left font-medium">Name</th>
                        <th class="px-4 py-2 text-left font-medium">Type</th>
                        <th class="px-4 py-2 text-left font-medium">Nullable</th>
                        <th class="px-4 py-2 text-left font-medium">PK</th>
                        <th class="px-4 py-2 w-20"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Entity.Properties)
                    {
                        var pName = p.Name;
                        <tr class="border-b last:border-b-0 hover:bg-muted/30 transition-colors">
                            <td class="px-4 py-2 font-mono">@p.Name</td>
                            <td class="px-4 py-2 font-mono text-muted-foreground">@p.ClrType</td>
                            <td class="px-4 py-2">@(p.IsNullable ? "yes" : "—")</td>
                            <td class="px-4 py-2">@(p.IsPrimaryKey ? "✓" : "—")</td>
                            <td class="px-4 py-2 text-right">
                                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small"
                                          class="text-destructive hover:text-destructive"
                                          @onclick="() => RemoveAsync(pName)">Remove</BbButton>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </BbCardContent>
    </BbCard>

    <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" @onclick="() => ShowAdd = true">+ Add Property</BbButton>

    @if (LastError is not null)
    {
        <BbAlert Variant="AlertVariant.Danger">
            <BbAlertDescription>@LastError</BbAlertDescription>
        </BbAlert>
    }
</div>

@if (ShowAdd)
{
    <AddPropertyDialog CsprojPath="@CsprojPath" EntityName="@Entity.Name"
        OnClose="() => { ShowAdd = false; }" OnAdded="AfterAddedAsync" />
}

@code {
    [Parameter] public Entity? Entity { get; set; }
    [Parameter] public string? CsprojPath { get; set; }
    [Parameter] public EventCallback OnMutated { get; set; }

    private bool ShowAdd { get; set; }
    private string? LastError { get; set; }

    private async Task RemoveAsync(string propertyName)
    {
        LastError = null;
        var r = await Catalog.MutateAsync(CsprojPath!, new RemoveProperty(Entity!.Name, propertyName), default);
        if (!r.Success) { LastError = r.Diagnostics.FirstOrDefault()?.Message ?? "Remove failed."; return; }
        await OnMutated.InvokeAsync();
    }

    private async Task AfterAddedAsync() { ShowAdd = false; await OnMutated.InvokeAsync(); }
}
