@if (Entity is not null)
{
    <div class="flex items-baseline gap-2 mb-4">
        <h2 class="text-xl font-semibold">@Entity.Name</h2>
        <span class="text-sm text-muted-foreground">@Entity.Namespace · @System.IO.Path.GetFileName(Entity.FilePath)</span>
    </div>
}

@code {
    /// <summary>The currently selected entity.</summary>
    [Parameter] public Entity? Entity { get; set; }
}
